# Copie este archivo como .env (no se sube a GitHub) y cambie la contraseña.
# Evite los caracteres ; y " en la contraseña.
POSTGRES_DB=makoto
POSTGRES_USER=makoto
POSTGRES_PASSWORD=cambie_esta_clave

# Clave temporal del Dashboard (cabecera X-Admin-Key) hasta el login JWT de T2-20
ADMIN_CLAVE_TEMPORAL=cambie_esta_clave_admin

# T2-05: código del estudio que se entrega a los participantes en el laboratorio.
# Vacío = cualquiera puede iniciar una sesión (útil en desarrollo y en la CI).
ESTUDIO_CODIGO_ACCESO=

# T2-06: URI de la rama «desarrollo» de Neon (postgresql://...neon.tech/neondb?sslmode=require).
# Vacío = la API usa el PostgreSQL local de Docker Compose. Nunca ponga aquí la rama «producción».
# T2-18: este archivo SÍ se sube a GitHub y la CI lo copia como .env: deje aquí solo valores de ejemplo.
# La URI real va únicamente en su .env (local) y en las variables de entorno de Render.
NEON_DATABASE_URL=
